// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Device {
  id          String          @id @default(cuid())
  deviceId    String          @unique
  name        String
  status      String          @default("offline")
  lastSeenAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  // Relations
  readings    SensorReading[]
  events      EventLog[]
  commands    DeviceCommand[]

  // Keep existing relations to avoid breaking old pages
  alarms       Alarm[]
  audioTracks  AudioTrack[]
  snapshots    SensorSnapshot[]
  deviceEvents DeviceEvent[]
}

model Alarm {
  id          String   @id @default(cuid())
  deviceId    String
  label       String
  time        String
  timezone    String   @default("Asia/Bangkok")
  greeting    String
  dfTrack     Int
  enabled     Boolean  @default(true)
  repeatDays  String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model AudioTrack {
  id          String   @id @default(cuid())
  deviceId    String
  track       Int
  fileName    String
  label       String
  feature     String
  description String?
  createdAt   DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId])
  @@unique([deviceId, track])
}

model SensorSnapshot {
  id            String   @id @default(cuid())
  deviceId      String
  gasEnabled    Boolean  @default(true)
  gasRaw        Int?
  gasDetected   Boolean  @default(false)
  tempEnabled   Boolean  @default(true)
  temperatureC  Float?
  flameDetected Boolean  @default(false)
  pirDetected   Boolean  @default(false)
  obstacleNear  Boolean  @default(false)
  createdAt     DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceEvent {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  severity  String   @default("info")
  message   String
  topic     String?
  payload   Json?
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model PinAssignment {
  id        String   @id @default(cuid())
  module    String
  signal    String
  gpio      String
  notes     String?
  reserved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SensorReading {
  id               String   @id @default(cuid())
  deviceId         String
  temperature      Float
  gasRaw           Int
  gasDetected      Boolean
  gasLevel         String
  temperatureHigh  Boolean
  pirDetected      Boolean
  obstacleNear     Boolean  @default(false)
  relay1           Boolean
  relay2           Boolean
  bluetoothRelay   Boolean
  buzzer           Boolean
  gasSensorEnabled Boolean
  createdAt        DateTime @default(now())

  device           Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(cuid())
  deviceId  String
  level     String
  type      String
  message   String
  payload   Json
  createdAt DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  payload   Json
  status    String   @default("SENT")
  ack       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

