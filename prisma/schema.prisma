generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Device {
  id           String           @id @default(cuid())
  name         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deviceId     String           @unique
  lastSeenAt   DateTime?
  status       String           @default("offline")
  alarms       Alarm[]
  audioTracks  AudioTrack[]
  commands     DeviceCommand[]
  deviceEvents DeviceEvent[]
  events       EventLog[]
  readings     SensorReading[]
  snapshots    SensorSnapshot[]
}

model Alarm {
  id         String   @id @default(cuid())
  deviceId   String
  label      String
  time       String
  timezone   String   @default("Asia/Jakarta")
  greeting   String
  dfTrack    Int
  enabled    Boolean  @default(true)
  repeatDays String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  device     Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model AudioTrack {
  id          String   @id @default(cuid())
  deviceId    String
  fileName    String
  label       String
  createdAt   DateTime @default(now())
  description String?
  feature     String
  track       Int
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([deviceId, track])
  @@index([deviceId])
}

model SensorSnapshot {
  id            String   @id @default(cuid())
  deviceId      String
  gasEnabled    Boolean  @default(true)
  gasRaw        Int?
  gasDetected   Boolean  @default(false)
  tempEnabled   Boolean  @default(true)
  temperatureC  Float?
  flameDetected Boolean  @default(false)
  pirDetected   Boolean  @default(false)
  obstacleNear  Boolean  @default(false)
  createdAt     DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceEvent {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  severity  String   @default("info")
  message   String
  topic     String?
  payload   Json?
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model PinAssignment {
  id        String   @id @default(cuid())
  module    String
  signal    String
  gpio      String
  notes     String?
  reserved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SensorReading {
  id               String   @id @default(cuid())
  deviceId         String
  temperature      Float
  gasRaw           Int
  gasDetected      Boolean
  gasLevel         String
  temperatureHigh  Boolean
  pirDetected      Boolean
  relay1           Boolean
  relay2           Boolean
  bluetoothRelay   Boolean
  buzzer           Boolean
  gasSensorEnabled Boolean
  createdAt        DateTime @default(now())
  obstacleNear     Boolean  @default(false)
  device           Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(cuid())
  deviceId  String
  level     String
  type      String
  message   String
  payload   Json
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  payload   Json
  status    String   @default("SENT")
  ack       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

/// Log event suara, sensor, tombol dari ESP32 maupun browser.
model SmartboxEvent {
  id          String   @id @default(cuid())
  deviceId    String
  level       String   @default("INFO")
  type        String
  message     String
  source      String   @default("esp32")
  payload     Json?
  track       Int?
  trackName   String?
  sensorValue Float?
  sensorType  String?
  createdAt   DateTime @default(now())

  @@index([deviceId])
  @@index([type])
  @@index([createdAt])
}

/// Status singleton terkini dari Smartbox.
/// Di-update oleh MQTT worker atau API setiap kali ada telemetry masuk.
model SmartboxStatus {
  id              String    @id @default(cuid())
  deviceId        String    @unique
  online          Boolean   @default(false)
  lastSeenAt      DateTime  @default(now())
  firmwareVersion String?
  ssid            String?
  ip              String?
  backendIp       String?
  mac             String?
  rssi            Int?
  gasRaw          Int?
  gasLevel        String    @default("normal")
  smokeDetected   Boolean   @default(false)
  gasDetected     Boolean   @default(false)
  temperatureC    Float?
  temperatureHigh Boolean   @default(false)
  pirDetected     Boolean   @default(false)
  obstacleNear    Boolean   @default(false)
  relay1          Boolean   @default(false)
  relay2          Boolean   @default(false)
  bluetoothAudio  Boolean   @default(false)
  buzzer          Boolean   @default(false)
  mq2Baseline     Int?
  smokeThreshold  Int?
  gasThreshold    Int?
  dfPlayerReady   Boolean   @default(false)
  lastTrackPlayed Int?
  lastVoiceAt     DateTime?
  lastAiQuery     String?
  lastAiResponse  String?
  lastAiAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deviceId])
}

model VoiceInteraction {
  id         String   @id @default(cuid())
  deviceId   String
  transcript String?
  replyText  String?
  audioUrl   String?
  status     String   @default("success")
  createdAt  DateTime @default(now())
  error      String?
  source     String?
}

model RelaySchedule {
  id          String   @id @default(cuid())
  name        String
  relayNumber Int
  startTime   String
  endTime     String
  days        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlarmSchedule {
  id        String    @id @default(cuid())
  name      String
  time      String
  track     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)
  deviceId  String    @default("smartbox-001")
  lastRunAt DateTime?
}

model PirGreetingSetting {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(false)
  track           Int      @default(10)
  startTime       String   @default("07:00")
  endTime         String   @default("22:00")
  cooldownSeconds Int      @default(10)
  playMode        String   @default("cooldown")
  days            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
