// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Device {
  id          String          @id @default(cuid())
  deviceId    String          @unique
  name        String
  status      String          @default("offline")
  lastSeenAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  // Relations
  readings    SensorReading[]
  events      EventLog[]
  commands    DeviceCommand[]

  // Keep existing relations to avoid breaking old pages
  alarms       Alarm[]
  audioTracks  AudioTrack[]
  snapshots    SensorSnapshot[]
  deviceEvents DeviceEvent[]
}

model Alarm {
  id          String   @id @default(cuid())
  deviceId    String
  label       String
  time        String
  timezone    String   @default("Asia/Jakarta")
  greeting    String
  dfTrack     Int
  enabled     Boolean  @default(true)
  repeatDays  String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model AudioTrack {
  id          String   @id @default(cuid())
  deviceId    String
  track       Int
  fileName    String
  label       String
  feature     String
  description String?
  createdAt   DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId])
  @@unique([deviceId, track])
}

model SensorSnapshot {
  id            String   @id @default(cuid())
  deviceId      String
  gasEnabled    Boolean  @default(true)
  gasRaw        Int?
  gasDetected   Boolean  @default(false)
  tempEnabled   Boolean  @default(true)
  temperatureC  Float?
  flameDetected Boolean  @default(false)
  pirDetected   Boolean  @default(false)
  obstacleNear  Boolean  @default(false)
  createdAt     DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceEvent {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  severity  String   @default("info")
  message   String
  topic     String?
  payload   Json?
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model PinAssignment {
  id        String   @id @default(cuid())
  module    String
  signal    String
  gpio      String
  notes     String?
  reserved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SensorReading {
  id               String   @id @default(cuid())
  deviceId         String
  temperature      Float
  gasRaw           Int
  gasDetected      Boolean
  gasLevel         String
  temperatureHigh  Boolean
  pirDetected      Boolean
  obstacleNear     Boolean  @default(false)
  relay1           Boolean
  relay2           Boolean
  bluetoothRelay   Boolean
  buzzer           Boolean
  gasSensorEnabled Boolean
  tempSensorEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())

  device           Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(cuid())
  deviceId  String
  level     String
  type      String
  message   String
  payload   Json
  createdAt DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  type      String
  payload   Json
  status    String   @default("SENT")
  ack       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
}

// ==========================================================
// MODEL BARU: SmartboxEvent & SmartboxStatus
// Standalone (tidak ada relasi ke Device) agar mudah
// digunakan tanpa perlu Device seed.
// ==========================================================

/// Log event suara, sensor, tombol dari ESP32 maupun browser.
model SmartboxEvent {
  id        String   @id @default(cuid())
  deviceId  String
  level     String   @default("INFO")   // INFO | WARNING | ERROR
  type      String                       // voice.played | gas.detected | assistant_intro | dll
  message   String
  source    String   @default("esp32")  // esp32 | browser | api
  payload   Json?

  // Untuk voice events
  track     Int?
  trackName String?

  // Untuk sensor events
  sensorValue Float?
  sensorType  String?  // gas | smoke | temperature | pir | obstacle

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([type])
  @@index([createdAt])
}

/// Status singleton terkini dari Smartbox.
/// Di-update oleh MQTT worker atau API setiap kali ada telemetry masuk.
model SmartboxStatus {
  id              String   @id @default(cuid())
  deviceId        String   @unique

  // Konektivitas
  online          Boolean  @default(false)
  lastSeenAt      DateTime @default(now())

  // Sensor status
  gasRaw          Int?
  gasLevel        String   @default("normal")  // normal | waspada | bahaya
  smokeDetected   Boolean  @default(false)
  gasDetected     Boolean  @default(false)
  temperatureC    Float?
  temperatureHigh Boolean  @default(false)
  pirDetected     Boolean  @default(false)
  obstacleNear    Boolean  @default(false)
  gasSensorEnabled Boolean @default(true)
  tempSensorEnabled Boolean @default(true)

  // Aktuator status
  relay1          Boolean  @default(false)
  relay2          Boolean  @default(false)
  bluetoothAudio  Boolean  @default(false)
  buzzer          Boolean  @default(false)

  // Kalibrasi MQ-2
  mq2Baseline     Int?
  smokeThreshold  Int?
  gasThreshold    Int?

  // DFPlayer status
  dfPlayerReady   Boolean  @default(false)
  lastTrackPlayed Int?
  lastVoiceAt     DateTime?

  // AI Assistant
  lastAiQuery     String?
  lastAiResponse  String?
  lastAiAt        DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deviceId])
}

model VoiceInteraction {
  id         String   @id @default(cuid())
  deviceId   String
  source     String?
  transcript String?
  replyText  String?
  audioUrl   String?
  status     String   @default("success")
  error      String?
  createdAt  DateTime @default(now())
}

model RelaySchedule {
  id          String   @id @default(cuid())
  name        String
  relayNumber Int
  startTime   String
  endTime     String
  days        String   // JSON stringified array of days, e.g. ["monday","tuesday"]
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlarmSchedule {
  id             String    @id @default(cuid())
  deviceId       String    @default("smartbox-001")
  name           String
  time           String
  track          Int
  active         Boolean   @default(true)
  days           String    @default("[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\",\"saturday\",\"sunday\"]")
  buzzerActive   Boolean   @default(false)
  buzzerDuration Int       @default(5)
  buzzerDelay    Int       @default(2)
  repeatCount    Int       @default(1)
  repeatDelay    Int       @default(5)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PirGreetingSetting {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(false)
  track           Int      @default(10)
  startTime       String   @default("07:00")
  endTime         String   @default("22:00")
  cooldownSeconds Int      @default(10)
  playMode        String   @default("cooldown")
  days            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GreetingVoiceSchedule {
  id              String    @id @default(cuid())
  name            String
  active          Boolean   @default(true)
  startTime       String    @default("07:00")
  endTime         String    @default("22:00")
  cooldown        Int       @default(20)
  mode            String    @default("random") // "random" | "custom"
  tracks          String    @default("[]")    // JSON array of tracks (e.g. "[25, 26]")
  days            String    @default("[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\",\"saturday\",\"sunday\"]")
  lastTrackPlayed Int?
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

